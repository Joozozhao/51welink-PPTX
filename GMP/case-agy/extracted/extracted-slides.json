      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u9500\u552e\uff1a\u5f90\u5229\u971e"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u6210\u5355\u65f6\u95f4\uff1a2023\u5e74"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u8ddf\u5355\u65f6\u95f4\uff1a1 \u5468\u5de6\u53f3"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u5e73\u53f0\u91d1\u989d\uff1a2.5\u4e07"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u9879\u76ee\u63cf\u8ff0\uff1a"
      },
      {
        "type": "text",
        "content": "\u9500\u552e\u5728\u77ed\u4fe1\u884c\u4e1a\u4ea4\u6d41\u5fae\u4fe1\u7fa4\u4e2d\u53ca\u65f6\u770b\u5230\u540c\u884c\u53d1\u5e03\u7684\u54a8\u8be2\u4fe1\u606f\uff0c\u5e76\u5728\u7b2c\u4e00\u65f6\u95f4\u4e0e\u5bf9\u65b9\u5b8c\u6210\u6b63\u5f0f\u6709\u6548\u7684\u6c9f\u901a\uff0c\u786e\u5b9aGMP \u6ee1\u8db3\u5bf9\u65b9\u9700\u6c42\u65f6\uff0c\u53ca\u65f6\u5b89\u6392\u63a8\u8fdb\u90e8\u7f72\u6d4b\u8bd5\u7b49\u5de5\u4f5c\uff0c\u5e76\u5b8c\u6210\u7b7e\u7ea6\u3002"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u7ecf\u9a8c\u603b\u7ed3\uff1a"
      },
      {
        "type": "text",
        "content": "\u654f\u9510\u6355\u6349\u5546\u673a:\u9500\u552e\u9700\u8981\u65f6\u523b\u5173\u6ce8\u884c\u4e1a\u52a8\u6001\u548c\u5ba2\u6237\u9700\u6c42\u53d8\u5316\uff0c\u654f\u9510\u5730\u6355\u6349\u5230\u5546\u673a\u5e76\u8fc5\u901f\u4f5c\u51fa\u53cd\u5e94\u3002\n\u5feb\u901f\u54cd\u5e94\u4e0e\u6df1\u5165\u6c9f\u901a:\u5728\u6355\u6349\u5230\u5546\u673a\u540e\uff0c\u9500\u552e\u9700\u8981\u8fc5\u901f\u4e0e\u5ba2\u6237\u5efa\u7acb\u8054\u7cfb\u5e76\u8fdb\u884c\u6df1\u5165\u6c9f\u901a\uff0c\u4e86\u89e3\u5ba2\u6237\u7684\u5177\u4f53\u9700\u6c42\u548c\u671f\u671b\u3002\n\u6280\u672f\u652f\u6301\u4e0e\u5b9a\u5236\u5316\u65b9\u6848:\u6280\u672f\u652f\u6301\u56e2\u961f\u662f\u9879\u76ee\u6210\u529f\u7684\u5173\u952e\u3002\u4ed6\u4eec\u9700\u8981\u6839\u636e\u5ba2\u6237\u9700\u6c42\u5236\u5b9a\u9488\u5bf9\u6027\u7684\u5b9a\u5236\u5316\u89e3\u51b3\u65b9\u6848\uff0c\u5e76\u5177\u5907\u4e30\u5bcc\u7684\u884c\u4e1a\u7ecf\u9a8c\u548c\u4e13\u4e1a\u77e5\u8bc6\u3002"
      }
    ],
    "images": [],
