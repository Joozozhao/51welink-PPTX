    "content": [
      {
        "type": "text",
        "content": "\u6210\u529f\u6848\u4f8b\u4ecb\u7ecd"
      },
      {
        "type": "text",
        "content": "\u81ea2018\u5e74GMP 1.0\u7248\u672c\u4e0a\u7ebf\u4ee5\u6765\uff0c\u7ecf\u8fc7\u516d\u5e74\u591a\u7684\u7a33\u5065\u53d1\u5c55\uff0c\u6211\u4eec\u5df2\u6210\u529f\u52a9\u529b\u8d85\u8fc7\u4e8c\u5341\u5bb6\u77e5\u540d\u4f01\u4e1a\u53ca\u673a\u6784\u5b9e\u73b0\u4e86\u6570\u5b57\u5316\u8f6c\u578b\u548c\u7ba1\u7406\u5347\u7ea7\u3002\u8fd9\u4e9b\u5ba2\u6237\u904d\u5e03\u5404\u4e2a\u884c\u4e1a\uff0c\u5305\u62ec\u6e56\u5357\u4e09\u6e58\u94f6\u884c\u3001\u5b81\u590f\u7a0e\u52a1\u3001\u8d35\u5dde\u7a0e\u52a1\u3001\u4eba\u6c11\u6570\u636e\u3001\u4e2d\u56fd\u822a\u53d1\u96c6\u56e2\u7b49\uff0c\u5145\u5206\u8bc1\u660e\u4e86GMP\u7cfb\u7edf\u7684\u5e7f\u6cdb\u5e94\u7528\u548c\u5353\u8d8a\u6027\u80fd\u3002\n\u5bf9\u4e8e\u60a8\u6765\u8bf4\uff0c\u8fd9\u4e9b\u6210\u529f\u6848\u4f8b\u4e0d\u4ec5\u662f\u4e00\u4efd\u5b9d\u8d35\u7684\u8d44\u6e90\uff0c\u66f4\u662f\u4e00\u4e2a\u542f\u53d1\u548c\u501f\u9274\u7684\u5b9d\u5e93\u3002\u6211\u4eec\u5e0c\u671b\u4e0e\u60a8\u4e00\u9053\u6df1\u5165\u6316\u6398\u81ea\u8eab\u9700\u6c42\uff0c\u4e0e\u8fd9\u4e9b\u6210\u529f\u6848\u4f8b\u8fdb\u884c\u5bf9\u6807\uff0c\u5171\u540c\u6253\u9020\u5c5e\u4e8e\u60a8\u7684\u6210\u529f\u6848\u4f8b\u6545\u4e8b\u3002"
      },
