      {
        "type": "text",
        "content": "\u8d35\u5dde\u4e91\u4e49\u8fbe\u81ea2020\u5e74\u8d77\u4fbf\u4e0e\u6211\u53f8\u5efa\u7acb\u4e86\u7a33\u56fa\u7684\u5408\u4f5c\u5173\u7cfb\u3002\u524d\u671f\u4e3b\u8981\u4ee5\u77ed\u4fe1\u5408\u4f5c\u4e3a\u4e3b\uff0c\u7136\u800c\uff0c\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\uff0c\u5ba2\u6237\u5185\u90e8\u5bf9\u63a5\u4eba\u53d1\u751f\u4e86\u53d8\u5316\uff0c\u63a5\u89e6\u4e0b\u6765\uff0c\u4e86\u89e3\u5230\uff0c\u800c\u5bf9\u63a5\u4eba\u4e5f\u60f3\u505a\u63a8\u52a8\u4e00\u4e9b\u4e8b\u60c5\uff0c\u8fd9\u4e3a\u6211\u53f8\u63d0\u4f9b\u4e86\u65b0\u7684\u5408\u4f5c\u673a\u4f1a\u3002\u9500\u552e\u540c\u4e8b\u654f\u9510\u5730\u6355\u6349\u5230\u4e86\u8fd9\u4e00\u53d8\u5316\uff0c\u5e76\u8fc5\u901f\u91c7\u53d6\u884c\u52a8\uff0c\u6210\u529f\u63a8\u8350\u4e86\u6211\u53f8\u7684GMP\u5e73\u53f0\u3002"
