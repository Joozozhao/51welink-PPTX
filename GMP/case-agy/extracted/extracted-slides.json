      {
        "type": "text",
        "content": "1"
      },
      {
        "type": "text",
        "content": "\u5b89\u5168\u63aa\u65bd-\u591a\u65b9\u4f4d"
      },
      {
        "type": "text",
        "content": "\u9ad8\u53ef\u7528\u6027-\u591a\u91cd\u4fdd\u969c"
      },
      {
        "type": "text",
        "content": "\u7cfb\u7edf\u5bf9\u63a5-\u6613\u5b9e\u65bd"
      },
      {
        "type": "text",
        "content": "\u79c1\u6709\u5316\u90e8\u7f72\nB/S+\u5fae\u670d\u52a1\u5b89\u5168\u67b6\u6784\n\u52a0\u5bc6\u914d\u7f6e\n\u5e95\u5c42\u6570\u636e\u52a0\u5bc6\uff0c\u654f\u611f\u6570\u636e\u52a0\u5bc6\u663e\u793a\n\u652f\u6301\u56fd\u5bc6\u7b97\u6cd5"
      },
      {
        "type": "text",
        "content": "\u7cfb\u7edf\u6545\u969c\u5728\u7ebf\u81ea\u52a8\u6062\u590d\n\u591a\u901a\u9053\u667a\u80fd\u8def\u7531\u548c\u5e76\u8054\u6280\u672f\n\u4efb\u4e00\u8282\u70b9\u652f\u6301\u8d1f\u8f7d\u5747\u8861\u3001\u70ed\u5907\n\u901a\u9053\u81ea\u52a8\u5207\u6362"
      },
      {
        "type": "text",
        "content": "\u9884\u7559\u63a5\u53e3\uff0c\u652f\u6301\u4e8c\u6b21\u5f00\u53d1\n\u652f\u6301\u96c6\u56e2\u591a\u7cfb\u7edf\u63a5\u5165\n\u652f\u6301\u63a5\u53e3\u6587\u4ef6\u3001SDK\u3001HTTP\u3001SOCKET\u591a\u91cd\u63a5\u5165\u65b9\u5f0f"
      },
      {
        "type": "text",
        "content": "\u53d1\u9001\u80fd\u529b-\u5927\u5bb9\u91cf"
      },
      {
        "type": "text",
        "content": "\u4ebf\u7ea7\u65e5\u53d1\u9001\u80fd\u529b\n\u9ad8\u6027\u80fd\u7f13\u5b58\u6280\u672f\n\u5206\u5e03\u5f0f\u8ba1\u7b97\u80fd\u529b\n\u5355\u6b21\u652f\u6301100\u4e07\u6761\u53f7\u7801\n\u652f\u6301\u77ed\u5f69\u4fe1\u3001\u8bed\u97f3\u77ed\u4fe1\u3001\u5fae\u4fe1\u591a\u91cd\u7c7b\u578b\u4fe1\u606f\u53d1\u9001"
      }
