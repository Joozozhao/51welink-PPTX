      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u7ecf\u9a8c\u603b\u7ed3\uff1a"
      },
      {
        "type": "text",
        "content": "\u5ba2\u60c5\u5173\u7cfb\u9700\u8981\u957f\u65f6\u95f4\u7684\u79ef\u7d2f\uff08\u4ee5\u5e74\u4e3a\u5355\u4f4d\uff09\uff0c\u5b9a\u671f\u62dc\u8bbf\u3001\u6df1\u5165\u4ea4\u6d41\u3001\u63d0\u4f9b\u4e13\u4e1a\u5efa\u8bae\u7b49\u65b9\u5f0f\uff0c\u83b7\u5f97\u5ba2\u6237\u7684\u4fe1\u4efb\uff1b\n\u9500\u552e\u4eba\u5458\u4e0d\u4ec5\u8981\u5173\u6ce8\u4e1a\u52a1\u672c\u8eab\uff0c\u66f4\u8981\u91cd\u89c6\u4e0e\u5ba2\u6237\u7684\u60c5\u611f\u8fde\u63a5\u3002\u771f\u8bda\u5730\u5bf9\u5f85\u5ba2\u6237\uff0c\u7528\u5fc3\u8046\u542c\u5ba2\u6237\u7684\u9700\u6c42\u548c\u53cd\u9988\uff0c\u79ef\u6781\u89e3\u51b3\u5408\u4f5c\u8fc7\u7a0b\u4e2d\u51fa\u73b0\u7684\u95ee\u9898\uff1b\n\u9500\u552e\u4eba\u5458\u9700\u8981\u4e0d\u65ad\u63d0\u5347\u81ea\u8eab\u4e13\u4e1a\u7d20\u517b\u548c\u670d\u52a1\u6c34\u5e73\u3001\u5584\u4e8e\u628a\u63e1\u5e02\u573a\u673a\u9047\u624d\u80fd\u5728\u6fc0\u70c8\u7684\u5e02\u573a\u7ade\u4e89\u4e2d\u8131\u9896\u800c\u51fa\u3002"
      }
