        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u9879\u76ee\u63cf\u8ff0\uff1a"
      },
      {
        "type": "text",
        "content": "\u6b64\u5ba2\u6237\u662f\u9500\u552e\u5728 2010 \u5e74\u5de6\u53f3\u8ba4\u8bc6\uff0c\u4e14\u957f\u671f\u4fdd\u6301\u7740\u8054\u7cfb\u30022018 \u5e74\uff0c\u94f6\u884c\u6709\u5e73\u53f0\u5347\u7ea7\u9700\u6c42\u65f6\uff0c\u7b2c\u4e00\u65f6\u95f4\u63a8\u8fdb\u6211\u53f8\u63a5\u5165\uff0c\u6700\u7ec8\u6210\u5355\u3002\u6b64\u5ba2\u6237\u5404\u7c7b\u4ea7\u54c1\u5408\u8ba1\u8d21\u732e\u6d41\u6c34 1000 \u4e07+"
