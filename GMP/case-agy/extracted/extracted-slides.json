      {
        "type": "text",
        "content": "\u654f\u9510\u6355\u6349\u5546\u673a:\u9500\u552e\u9700\u8981\u65f6\u523b\u5173\u6ce8\u5ba2\u6237\u52a8\u6001\uff0c\u654f\u9510\u5730\u6355\u6349\u5230\u5bf9\u63a5\u4eba\u53d8\u66f4\u7b49\u5546\u673a\uff0c\u5e76\u8fc5\u901f\u91c7\u53d6\u884c\u52a8\u3002 \n\u53ca\u65f6\u505a\u4ea7\u54c1\u63a8\u8350:\u5728\u4e86\u89e3\u5ba2\u6237\u9700\u6c42\u540e\uff0c\u9500\u552e\u9700\u8981\u53ca\u65f6\u5411\u5ba2\u6237\u63a8\u8350\u9002\u5408\u7684\u4ea7\u54c1\uff0c\u5e76\u8be6\u7ec6\u4ecb\u7ecd\u4ea7\u54c1\u7684\u529f\u80fd\u4f18\u52bf\u548c\u6280\u672f\u7279\u70b9\u3002 \n\u4e13\u4e1a\u7684\u670d\u52a1\u652f\u6491:\u5728\u9879\u76ee\u6267\u884c\u8fc7\u7a0b\u4e2d\uff0c\u4e13\u4e1a\u7684\u670d\u52a1\u652f\u6491\u56e2\u961f\u662f\u786e\u4fdd\u9879\u76ee\u6210\u529f\u7684\u5173\u952e\u3002\u4ed6\u4eec\u9700\u8981\u4e0e\u5ba2\u6237\u7d27\u5bc6\u5408\u4f5c\uff0c\u53ca\u65f6\u89e3\u51b3\u95ee\u9898\u548c\u6311\u6218\u3002"
      }
    ],
