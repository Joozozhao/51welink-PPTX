      {
        "type": "text",
        "content": "\u5b81\u590f\u7a0e\u52a1"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u9500\u552e\uff1a\u90ed\u51ac\u6885"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u6210\u5355\u65f6\u95f4\uff1a2023 \u5e74"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u8ddf\u5355\u65f6\u95f4\uff1a1\u5e74 + "
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u5e73\u53f0\u91d1\u989d\uff1a9.8\u4e07"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u9879\u76ee\u63cf\u8ff0\uff1a"
      },
      {
        "type": "text",
        "content": "\u5b81\u590f\u7535\u4fe1\u8fc7\u53bb\u4e00\u76f4\u5bf9\u77ed\u6d88\u606f\u4e1a\u52a1\u6301\u4fdd\u7559\u6001\u5ea6\uff0c\u8ba4\u4e3a\u5176\u6536\u5165\u8d21\u732e\u76f8\u5bf9\u8f83\u5c0f\uff0c\u56e0\u6b64\u5e76\u672a\u5728\u6b64\u9886\u57df\u6295\u5165\u592a\u591a\u7cbe\u529b\u3002\u5b81\u590f\u7535\u4fe1\u5076\u7136\u673a\u9047\u7b7e\u7ea6\u4e86\u5b81\u590f\u7a0e\u52a1\u8fd9\u4e00\u91cd\u8981\u7684\u653f\u4f01\u5ba2\u6237\u3002\u5b81\u590f\u7535\u4fe1\u53d1\u73b0\u81ea\u5df1\u5bf9\u4e8e\u670d\u52a1\u6b64\u7c7b\u5ba2\u6237\u7684\u77ed\u4fe1\u5e73\u53f0\u9700\u6c42\u7f3a\u4e4f\u76f8\u5e94\u7684\u7ecf\u9a8c\u3002\u9500\u552e\u540c\u4e8b\u4e86\u89e3\u5230\u60c5\u51b5\u540e\uff0c\u5411\u5b81\u590f\u7535\u4fe1\u63a8\u8350 GMP \u4ea7\u54c1\uff0c\u53ca\u5c55\u73b0\u6211\u53f8\u7684\u670d\u52a1\u80fd\u529b\uff0c\u6700\u7ec8\u83b7\u5f97\u4e86\u5ba2\u6237\u7684\u8ba4\u53ef\u3002"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u7ecf\u9a8c\u603b\u7ed3\uff1a"
      },
      {
        "type": "text",
        "content": "\u654f\u9510\u6355\u6349\u5546\u673a:\u9500\u552e\u9700\u8981\u65f6\u523b\u4fdd\u6301\u654f\u9510\u7684\u5e02\u573a\u89e6\u89c9\uff0c\u53ca\u65f6\u6355\u6349\u5230\u5ba2\u6237\u7684\u6f5c\u5728\u9700\u6c42\uff0c\u5e76\u8f6c\u5316\u4e3a\u5b9e\u9645\u7684\u5408\u4f5c\u673a\u4f1a\u3002\n\u6df1\u5165\u4e86\u89e3\u5ba2\u6237\u9700\u6c42:\u5728\u4e0e\u5ba2\u6237\u6c9f\u901a\u65f6\uff0c\u9500\u552e\u9700\u8981\u6df1\u5165\u4e86\u89e3\u5ba2\u6237\u7684\u5b9e\u9645\u9700\u6c42\uff0c\u786e\u4fdd\u63d0\u4f9b\u7684\u4ea7\u54c1\u548c\u670d\u52a1\u80fd\u591f\u6ee1\u8db3\u5ba2\u6237\u7684\u671f\u671b\u3002\n\u4e13\u4e1a\u89e3\u51b3\u65b9\u6848\u4e0e\u9ad8\u6548\u6267\u884c:\u9762\u5bf9\u5ba2\u6237\u7684\u7279\u6b8a\u9700\u6c42\uff0c\u9500\u552e\u56e2\u961f\u9700\u8981\u4e0e\u6280\u672f\u56e2 \u961f\u7d27\u5bc6\u5408\u4f5c\uff0c\u63d0\u4f9b\u4e13\u4e1a\u7684\u89e3\u51b3\u65b9\u6848\uff0c\u5e76\u786e\u4fdd\u9879\u76ee\u7684\u9ad8\u6548\u6267\u884c\u3002"
      }
    ],
